{
  "camera": {
    "default_source": 0,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "rtsp_url": ""
  },
  "yolo": {
    "model_path": "models/yolov8_defect.pt",
    "confidence_threshold": 0.5,
    "iou_threshold": 0.45,
    "device": "cpu",
    "img_size": 640
  },
  "inspection": {
    "auto_save": true,
    "save_defect_only": true,
    "inspection_interval": 0.1,
    "alert_on_defect": true,
    "alert_sound": true
  },
  "database": {
    "path": "data/inspection.db",
    "auto_backup": true,
    "backup_interval": 24
  },
  "plc": {
    "enabled": false,
    "ip_address": "192.168.1.10",
    "port": 502,
    "unit_id": 1,
    "trigger_address": 0,
    "result_address": 1
  },
  "report": {
    "output_path": "reports/",
    "auto_generate": true,
    "interval": "daily",
    "format": "excel"
  },
  "ui": {
    "theme": "dark",
    "language": "th",
    "show_statistics": true,
    "show_log": true,
    "auto_scroll_log": true
  }
}
