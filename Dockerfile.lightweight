# Lightweight Dockerfile - CPU Only, Small Size
# Best for testing and development
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:0 \
    QT_X11_NO_MITSHM=1

# Install only essential system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make \
    libgl1 libglib2.0-0 libgomp1 \
    libx11-6 libxext6 libxrender1 \
    libsm6 libice6 \
    libxcb1 libxkbcommon0 libdbus-1-3 \
    libfontconfig1 libfreetype6 \
    v4l-utils wget git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install minimal Python packages (without heavy dependencies like matplotlib, pyqtgraph)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    ultralytics>=8.0.0 \
    opencv-python-headless>=4.8.0 \
    torch>=2.0.0 --index-url https://download.pytorch.org/whl/cpu \
    torchvision>=0.15.0 --index-url https://download.pytorch.org/whl/cpu \
    numpy>=1.24.0 \
    pillow>=10.0.0 \
    PyQt5>=5.15.0 \
    pymodbus>=3.5.0 \
    requests>=2.31.0 \
    pandas>=2.0.0 \
    openpyxl>=3.1.0 \
    python-dateutil>=2.8.0 \
    pyyaml>=6.0.0

COPY . .

RUN mkdir -p data models reports logs config && \
    chmod +x main.py

CMD ["python", "main.py"]
